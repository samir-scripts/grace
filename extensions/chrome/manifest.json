{
  "manifest_version": 3,
  "name": "grace. Focus Companion",
  "version": "1.1.4",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "minimum_chrome_version": "116",
  "key": "",
  "description": "Enforces distraction blocking during grace. focus sessions.",
  "permissions": [
    "alarms",
    "storage",
    "declarativeNetRequest",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "chrome-background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Open grace. Focus Companion",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "homepage_url": "https://grace-focus.github.io/"
}
