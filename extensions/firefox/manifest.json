{
  "manifest_version": 3,
  "name": "grace. Focus Companion",
  "version": "1.1.1",
  "description": "Enforces distraction blocking during grace. focus sessions.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' ws://127.0.0.1:*;"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "focus@pomotroid.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personallyIdentifyingInfo"
        ]
      }
    }
  },
  "homepage_url": "https://grace-focus.github.io/"
}
