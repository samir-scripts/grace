{
  "manifest_version": 3,
  "name": "Pomotroid Focus Companion",
  "version": "1.0.0",
  "description": "Enforces distraction blocking during Pomotroid focus sessions in Safari.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
