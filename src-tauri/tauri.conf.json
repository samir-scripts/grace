{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "grace.",
  "mainBinaryName": "pomotroid",
  "version": "1.7.2-beta.1",
  "identifier": "com.splode.pomotroid",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "grace.",
        "width": 360,
        "height": 478,
        "minWidth": 240,
        "minHeight": 240,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "backgroundColor": "#2F384B",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDMTE5MDhGMEMyMDNDNjYKUldSbVBDQU1qNUFSZkc4SXhsOGx6Q1d6UkNPbHlBTUU3Qzhlb0cwa2pZZjk0S1RxNVUweS9YNlQK",
      "endpoints": [
        "https://raw.githubusercontent.com/samir-scripts/grace/main/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../extensions/dist/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "Copyright \u00a9 2017\u20132026 Christopher Murphy (Splode). MIT License.",
    "shortDescription": "grace. \u2014 a simple Pomodoro timer and focus blocker",
    "longDescription": "grace. is a simple, configurable and visually pleasing Pomodoro timer with focus blocking, forked from Pomotroid.",
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": []
      }
    },
    "macOS": {
      "dmg": {
        "windowPosition": {
          "x": 400,
          "y": 100
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      },
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "installMode": "perMachine"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
